# 代码不加载 .env（本项目只有 @vercel/blob 一个依赖，没有 dotenv）。这个文件只是文档，
# 实际使用请 export 到 shell，或在 Vercel 项目设置里配置环境变量。

# 必填。只保存在服务端，绝不会下发到浏览器。
DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key

# 可选：换供应商或换模型时改这两项，接口是 OpenAI 兼容的。
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_MS=35000

# 调试台 /studio.html 用的两项。不配这两个，Agent 照常回答（用代码里的默认规则），
# 只是调试台进不去、也存不了东西。
#
# 访问口令，至少 12 位，建议 20 位以上随机串。
# 与 web/ 的地图后台用不同的口令：两边各自泄露时影响面小一半。
ADMIN_ACCESS_TOKEN=replace-with-a-long-random-admin-passphrase
# 线上把私有 Vercel Blob 连接到项目即可；平台会自动注入 BLOB_STORE_ID 和短期 OIDC token，
# 不需要手工创建长期密钥。下面这一项只供本地开发或旧式 Blob 连接使用。
BLOB_READ_WRITE_TOKEN=connect-a-vercel-blob-store

# 仅本地开发服务器使用，Vercel 上无效。
PORT=5174
HOST=127.0.0.1
