{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node prepare-vercel.mjs",
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/runtime-config.js",
      "destination": "/api/runtime-config"
    }
  ],
  "functions": {
    "api/runtime-config.js": {
      "maxDuration": 10
    },
    "api/map/walking.js": {
      "maxDuration": 10
    },
    "api/content.js": {
      "maxDuration": 10
    },
    "api/admin/session.js": {
      "maxDuration": 10
    },
    "api/admin/content.js": {
      "maxDuration": 10
    }
  }
}
